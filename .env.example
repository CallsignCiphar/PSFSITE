# PostgreSQL Database (Neon / Vercel Postgres / Self-hosted)
DATABASE_URL="postgresql://user:password@localhost:5432/psf_db?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/psf_db?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="super-secret-auth-key-at-least-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"

# Cloudflare R2 Storage (S3-compatible)
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_BUCKET_PUBLIC="psf-public"
R2_BUCKET_PRIVATE="psf-private"
NEXT_PUBLIC_CDN_URL="https://cdn.forumstrategic.com"

# Upstash Redis (Cache & Rate Limiting)
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Transactional Email (Resend)
RESEND_API_KEY="re_123456789"
EMAIL_FROM="Pakistan Strategic Forum <no-reply@forumstrategic.com>"

# Cloudflare Turnstile Bot Protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAA..."
TURNSTILE_SECRET_KEY="0x4AAAAAA..."

# YouTube Data API
YOUTUBE_API_KEY="your-google-youtube-api-key"
YOUTUBE_CHANNEL_ID="your-youtube-channel-id"
